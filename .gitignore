# Godot 4+ specific ignores
.godot/
/android/

# Audio transient files (old live-orchestrator naming; local dev leftovers only —
# baked episode audio now lives under shows/ and is committed intentionally)
audio/*skit*_line*.mp3
audio/*skit*_line*.mp3.import

# Web export build output (regenerated by .github/workflows/deploy-pages.yml)
/build/
/build_test/

# shows/ audio is committed data, but a local Godot editor auto-imports it as
# a project resource (it sits under the project root) — these are excluded
# from the Web export (export_presets.cfg exclude_filter) and never needed.
shows/**/*.mp3.import

# Secrets and local scripts
start_comedy.ps1

# godot-ai MCP plugin (self-updating; reinstall from upstream, not tracked here)
addons/godot_ai/
godot-ai-LICENSE.txt

# Python bytecode
__pycache__/
