      "scene": "coffee_shop"
    },
    {
      "type": "skit_boundary"
    },
    {
      "type": "play_audio",
      "actor": "B",
      "file": "audio/line006.mp3",
      "text": "The movie\u2019s big question is whether reality is a simulation. Mine is whether this lineup moves.",
      "laugh": false,
      "duration_s": 6.86
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line007.mp3",
      "text": "A simulation would explain why the person ahead of us has been choosing a Timbits dozen for six minutes.",
      "laugh": false,
      "duration_s": 6.12
    },
    {
      "type": "play_audio",
      "actor": "B",
      "file": "audio/line008.mp3",
      "text": "Maybe they\u2019re testing every possible combination.",
      "laugh": false,
      "duration_s": 3.55
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line009.mp3",
      "text": "The Matrix came out in 1999, and it made computer-generated reality feel like a very stylish nightmare.",
      "laugh": false,
      "duration_s": 7.22
    },
    {
      "type": "play_audio",
      "actor": "B",
      "file": "audio/line010.mp3",
      "text": "I\u2019ll take one double-double and a reality with fewer menu decisions.",
      "laugh": false,
      "duration_s": 4.51
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line011.mp3",
      "text": "Careful. That\u2019s how the machines get you: unlimited customization.",
      "laugh": false,
      "duration_s": 5.64
    },
    {
      "type": "set_scene",
      "scene": "apartment"
    },
    {
      "type": "skit_boundary"
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line012.mp3",
      "text": "I tried the spoon thing. \u2018There is no spoon.\u2019",
      "laugh": false,
      "duration_s": 4.22
    },
    {
      "type": "play_audio",
      "actor": "B",
      "file": "audio/line013.mp3",
      "text": "And?",
      "laugh": false,
      "duration_s": 1.87
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line014.mp3",
      "text": "I stared at it until I realized the spoon was real, but my confidence wasn\u2019t.",
      "laugh": false,
      "duration_s": 5.04
    },
    {
      "type": "play_audio",
      "actor": "B",
      "file": "audio/line015.mp3",
      "text": "That\u2019s the trick in the movie: Neo learns to question what seems fixed inside the simulation.",
      "laugh": false,
      "duration_s": 5.88
    },
    {
      "type": "play_audio",
      "actor": "A",
      "file": "audio/line016.mp3",
      "text": "I questioned the spoon so hard it became a fork.",
